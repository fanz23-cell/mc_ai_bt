<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mc_ai_bt</name>
  <version>0.1.0</version>
  <description>AI-BT mission manager, planner validator and execution shell.</description>
  <maintainer email="yue.feng@mindchildren.com">Yue Feng</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>mc_one</depend>
  <exec_depend>mc_resource_authority</exec_depend>
  <exec_depend>mc_world_state</exec_depend>
  <exec_depend>mc_multimodal</exec_depend>
  <exec_depend>seattle_lab</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
